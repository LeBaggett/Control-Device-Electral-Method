/* Paste these wrappers into generated main.c USER CODE 4.
 * They can call static MX_* functions in that same translation unit.
 * Includes app.h/board.h/pinout.h go in USER CODE Includes. */
void board_cube_clock_init(void) { SystemClock_Config(); }
void board_cube_gpio_init(void) { MX_GPIO_Init(); }
void board_cube_peripherals_init(void)
{
    MX_DMA_Init();
    MX_SPI1_Init();
    MX_ADC1_Init();
    MX_I2C1_Init();
    MX_TIM2_Init();
    /* Include sd_io.h, runtime_config.h and fatfs.h (when enabled).
     * Unlike MX_SDIO_SD_Init, this helper does not trap on an absent card. */
    (void)board_sd_prepare();
#if THERMAL_USE_FATFS
    MX_FATFS_Init(); /* Link disk I/O driver before sdlog_init mounts volume. */
#endif
}

